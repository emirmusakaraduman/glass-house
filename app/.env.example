# Copy to .env.local. Never commit .env.local.

# mock = in-memory demo data (works today). chain = devnet program via the IDL (once it exists).
NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=HLKhCx1dFCCH3oTaaQEBEXZ5PShftueTFTEmKVZFyrP2
NEXT_PUBLIC_USDC_MINT=
# Optional: pin a pool by its address. Otherwise the lowest pool_id of each asset type is used.
NEXT_PUBLIC_HOUSE_POOL=
NEXT_PUBLIC_VEHICLE_POOL=

# İlan Bulucu (server only, never prefix these with NEXT_PUBLIC_)
FIRECRAWL_API_KEY=
# URL templates, several separated by |. Placeholders: {city} {minPrice} {maxPrice}
# Only add sources whose robots.txt and terms of use allow it. Checked on 2026-11-28:
#   Panama Equity (homes): robots.txt allows /property-city/ and /listings/, Crawl-delay: 10,
#     no terms of use on the site; the privacy policy has no rule against automated access.
#     First page only (paged lists /page/ and ?keyword= ?s= ?ct_status= are disallowed).
#   Automarket (cars): robots.txt allows /venta-de-autos/ (Content-Signal: ai-train=no,
#     use=reference); its terms cover car rental only, nothing against automated access.
#   Never: Encuentra24 (terms ban scraping), Compreoalquile (terms ban bots and copying data),
#     Champion Motors (terms ban automated extraction to republish).
# Not secrets: these are public page addresses. The server asks each host at most once every
# 10 s and caches a city's page for 15 minutes.
FIRECRAWL_HOUSE_URLS=https://www.panamaequity.com/property-city/panama-city/
# Automarket is allowed but its page takes ~18 s to scrape, past the 8 s budget below, so cars stay
# on sample data. To try it locally with a longer FIRECRAWL_TIMEOUT_MS:
#   FIRECRAWL_VEHICLE_URLS=https://www.automarket.com.pa/venta-de-autos/inventario
FIRECRAWL_VEHICLE_URLS=
# off = always use src/data/listings.seed.json
FIRECRAWL_LIVE=on
# Cities that may search live, separated by |. Others get sample data with no warning.
FIRECRAWL_LIVE_CITIES="Panama City"
# Netlify functions stop at 10 s: after this many ms the finder falls back to sample data.
FIRECRAWL_TIMEOUT_MS=8000

# Public URL of the deployed site, for absolute OpenGraph links (e.g. https://glasshouse.vercel.app)
NEXT_PUBLIC_SITE_URL=
