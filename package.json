{
  "name": "glasshouse",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "anchor build --no-idl -- --arch v0 && anchor idl build -o target/idl/glasshouse.json -t target/types/glasshouse.ts",
    "test": "mocha -n no-experimental-strip-types -r ts-node/register -t 1000000 \"tests/**/*.test.ts\"",
    "sim:stress": "ts-node -P ./tsconfig.json scripts/stress.ts",
    "seed:demo": "ts-node -P ./tsconfig.json scripts/seed.ts",
    "test:localnet": "bash scripts/test-localnet.sh",
    "deploy:usdc": "ts-node -P scripts/tsconfig.json scripts/create-mock-usdc.ts",
    "deploy:wallets": "ts-node -P scripts/tsconfig.json scripts/create-wallets.ts",
    "deploy:pools": "ts-node -P scripts/tsconfig.json scripts/create-pools.ts",
    "idl:export": "ts-node -P scripts/tsconfig.json scripts/export-idl.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "chai": "^4.3.4",
    "litesvm": "0.8.0",
    "mocha": "^10.0.0",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
